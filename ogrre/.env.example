# OGRRE backend environment template.
# Copy this file to .env in this directory and fill in the blank values.
# Do not commit .env or service-account JSON files.
#
# Relative service-account key paths are resolved from this ogrre/ directory
# by direct local runs and from /code/ogrre in Docker/Kubernetes.

# Application context
# Required: yes. Use development, staging, or the deployed collaborator env name.
ENVIRONMENT=development

# Required: yes for collaborator-scoped local development and anonymous/dev flows.
# Examples: isgs, newts, osage, ca, rrc, staging.
COLLABORATOR=

# Required: yes for browser access. Comma-separated list or JSON array.
# Local frontend example: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Required: yes when links back to this backend are generated.
BACKEND_URL=http://localhost:8001

# Authentication and sessions
# Required: yes. Set false only for isolated local development or tests.
REQUIRE_AUTH=true

# Required when REQUIRE_AUTH=true. Supported values: google, cilogon.
AUTH_PROVIDER=google

# Required for production HTTPS cookies; leave blank for localhost.
SESSION_COOKIE_DOMAIN=

# Required: yes. Use false for localhost over HTTP, true for HTTPS deployments.
SESSION_COOKIE_SECURE=false

# Required: yes. Usually lax.
SESSION_COOKIE_SAMESITE=lax

# Optional: seconds before the browser access-session cookie expires.
SESSION_COOKIE_MAX_AGE_SECONDS=3600

# Optional: seconds before the refresh-session cookie expires.
REFRESH_COOKIE_MAX_AGE_SECONDS=2592000

# Google OAuth. Required when REQUIRE_AUTH=true and AUTH_PROVIDER=google.
token_uri=https://oauth2.googleapis.com/token
client_id=
client_secret=

# CILogon OAuth. Required only when REQUIRE_AUTH=true and AUTH_PROVIDER=cilogon.
cilogon_token_uri=
cilogon_client_id=
cilogon_client_secret=

# MongoDB
# Required: yes. DB_NAME is always required.
DB_NAME=

# Required: yes. Use either a full mongodb:// or mongodb+srv:// URI, or the
# host fragment used with DB_USERNAME/DB_PASSWORD.
DB_CONNECTION=

# Required when DB_CONNECTION is not a full MongoDB URI.
DB_USERNAME=
DB_PASSWORD=

# Google Cloud project and region
# Required when STORAGE_BACKEND=google or DOCUMENT_AI_BACKEND=google.
PROJECT_ID=

# Required for Google Document AI. Use us unless the processors live elsewhere.
LOCATION=us

# File storage
# Required: yes. Supported values: google, local.
STORAGE_BACKEND=google

# Required when STORAGE_BACKEND=google.
STORAGE_BUCKET_NAME=

# Required when STORAGE_BACKEND=google outside GCP workload identity.
# Use the storage runtime service account key only.
STORAGE_SERVICE_KEY=storage-service-key.json

# Optional when STORAGE_BACKEND=local; defaults are shown here.
LOCAL_STORAGE_ROOT=~/.ogrre/uploads
LOCAL_STORAGE_URL_BASE=http://localhost:8001/local-storage

# Document AI
# Required: yes. Supported values: google, local/custom.
DOCUMENT_AI_BACKEND=google

# Required when DOCUMENT_AI_BACKEND=google outside GCP workload identity.
# Use the Document AI runtime service account key only.
DOCUMENT_AI_SERVICE_KEY=document-ai-service-key.json

# Required when DOCUMENT_AI_BACKEND is not google.
DOCUMENT_AI_URL=

# Optional: request timeout in seconds for custom Document AI HTTP backends.
DOCUMENT_AI_TIMEOUT=60

# Required for current OGRRE deployments so processor config comes from MongoDB.
USE_DB_PROCESSORS=true

# Optional batch Document AI controls.
DOCUMENT_AI_BATCH_TIMEOUT_SECONDS=7200
DOCUMENT_AI_BATCH_OUTPUT_PREFIX=document_ai_batch_outputs
DOCUMENT_AI_BATCH_DUPLICATE_FIELD_KEYS=project_name,client_name,client_address
DOCUMENT_AI_BATCH_LOG_BLOB_NAME_SAMPLE_LIMIT=20

# Document image processing
# Optional: detect likely blank/whitespace documents.
DETECT_WHITESPACE=true

# Optional local directories. Defaults are under ~/.uow when omitted.
LOG_DIR=~/.uow/logs
IMG_DIR=~/.uow/uploaded_images
EXPORT_DIR=~/.uow/exports

# Optional diagnostics/performance tuning. Leave disabled unless investigating.
MEMORY_PROFILE=false
MEMORY_PROFILE_RATE=1
MEMORY_PROFILE_TOP=10
PROCESS_IMAGE_IN_SUBPROCESS=false

# Deployment metadata. Optional; GitHub/Kubernetes set these automatically.
OGRRE_BACKEND_IMAGE=
OGRRE_BACKEND_DEPLOY_RUN_ID=
OGRRE_BACKEND_DEPLOYED_AT=

# Docker Compose only. Optional. Must match a directory under deployment/nginx/.
NGINX_ENV=staging
