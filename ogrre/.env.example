# OGRRE backend environment template.
# Copy this file to .env in this directory and fill in the blank values.
# Do not commit .env or service-account JSON files.
#
# Relative service-account key paths are resolved from this ogrre/ directory
# by direct local runs and from /code/ogrre in Docker/Kubernetes.

# Required configuration
# Keep these values explicit for normal local, staging, and production runtime.
# Some entries are conditionally required based on the auth/storage/Doc AI
# backends selected below.

# Core app context. ENVIRONMENT names the runtime environment, COLLABORATOR
# scopes collaborator-specific behavior, ALLOWED_ORIGINS must include the
# frontend origins allowed to call the API, and BACKEND_URL is used when the
# backend generates links back to itself.
ENVIRONMENT=development
COLLABORATOR=
ALLOWED_ORIGINS=http://localhost:3000
BACKEND_URL=http://localhost:8001

# MongoDB. DB_NAME and DB_CONNECTION are required. DB_CONNECTION can be a full
# mongodb:// or mongodb+srv:// URI; otherwise the app combines it with
# DB_USERNAME and DB_PASSWORD.
DB_NAME=
DB_CONNECTION=
DB_USERNAME=
DB_PASSWORD=

# Authentication provider. REQUIRE_AUTH=false is only for isolated local
# development or tests. Fill the credential triplet for the selected provider:
# Google when AUTH_PROVIDER=google, CILogon when AUTH_PROVIDER=cilogon.
REQUIRE_AUTH=true
AUTH_PROVIDER=google
token_uri=https://oauth2.googleapis.com/token
client_id=
client_secret=
cilogon_token_uri=
cilogon_client_id=
cilogon_client_secret=

# Session cookies. For localhost, keep SESSION_COOKIE_DOMAIN blank and
# SESSION_COOKIE_SECURE=false. For HTTPS deployments, set
# SESSION_COOKIE_SECURE=true and use the deployed domain policy.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE_SECONDS=3600
REFRESH_COOKIE_MAX_AGE_SECONDS=2592000

# Google Cloud runtime. PROJECT_ID is required when either Google Cloud Storage
# or Google Document AI is enabled. LOCATION must match the Document AI
# processor location.
PROJECT_ID=
LOCATION=us

# Storage runtime. STORAGE_BACKEND=google requires STORAGE_BUCKET_NAME and the
# storage runtime service account key path in STORAGE_SERVICE_KEY. Use the
# storage account only here, not the deployment/Terraform account.
STORAGE_BACKEND=google
STORAGE_BUCKET_NAME=
STORAGE_SERVICE_KEY=storage-service-key.json

# Document AI runtime. DOCUMENT_AI_BACKEND=google requires the Document AI
# service account key path in DOCUMENT_AI_SERVICE_KEY. The same account handles
# online/batch processing and processor deployment/undeployment from the app.
DOCUMENT_AI_BACKEND=google
DOCUMENT_AI_SERVICE_KEY=document-ai-service-key.json

# Processor configuration. Current OGRRE deployments expect processor config
# in MongoDB.
USE_DB_PROCESSORS=true

# Optional configuration

# Local storage. Used only when STORAGE_BACKEND=local.
LOCAL_STORAGE_ROOT=~/.ogrre/uploads
LOCAL_STORAGE_URL_BASE=http://localhost:8001/local-storage

# Custom/local Document AI HTTP backend. DOCUMENT_AI_URL is required only when
# DOCUMENT_AI_BACKEND is not google.
DOCUMENT_AI_URL=
DOCUMENT_AI_TIMEOUT=60

# Batch Document AI controls. These defaults control long-running-operation
# timeout, output prefix, duplicate-field monitoring, and log sample size.
DOCUMENT_AI_BATCH_TIMEOUT_SECONDS=7200
DOCUMENT_AI_BATCH_OUTPUT_PREFIX=document_ai_batch_outputs
DOCUMENT_AI_BATCH_DUPLICATE_FIELD_KEYS=project_name,client_name,client_address
DOCUMENT_AI_BATCH_LOG_BLOB_NAME_SAMPLE_LIMIT=20

# Document image processing and diagnostics. Leave profiling disabled unless
# investigating memory or image-processing behavior.
DETECT_WHITESPACE=true
MEMORY_PROFILE=false
MEMORY_PROFILE_RATE=1
MEMORY_PROFILE_TOP=10
PROCESS_IMAGE_IN_SUBPROCESS=false

# Local directories. Defaults are under ~/.uow when omitted.
LOG_DIR=~/.uow/logs
IMG_DIR=~/.uow/uploaded_images
EXPORT_DIR=~/.uow/exports

# Deployment metadata. GitHub/Kubernetes set these automatically.
OGRRE_BACKEND_IMAGE=
OGRRE_BACKEND_DEPLOY_RUN_ID=
OGRRE_BACKEND_DEPLOYED_AT=

# Docker Compose only. Must match a directory under deployment/nginx/ when
# running the full nginx/certbot Compose stack.
NGINX_ENV=staging
