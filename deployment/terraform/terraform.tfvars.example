# Defaults for the shared OGRRE project live in variables.tf.
# Copy this file to terraform.tfvars only when you need local overrides.

# Explicit browser origins for Google-backed local development or alternate hosts.
# This replaces the bucket's default origin list; retain its production origin.
# upload_bucket_cors_origins = {
#   uploaded_documents_v0 = ["https://uow-carbon.org", "http://localhost:3000"]
# }

# Legacy Compute Engine VMs are disabled by default. Re-enable specific
# legacy VMs by listing names from legacy_backend_vms:
#
# enabled_legacy_backend_vms = ["isgs"]
#
# Add a GKE-only collaborator without creating a legacy Compute Engine VM:
#
# gke_backend_overrides = {
#   boots = {}
# }

# The default upload bucket name is <collaborator>_uploads.
# Override it only for existing buckets or intentional shared buckets:
#
# gke_backend_overrides = {
#   boots = {
#     upload_bucket_name = "custom_upload_bucket"
#   }
# }
#
# Override per-backend GKE settings when defaults are not enough:
#
# gke_backend_overrides = {
#   boots = {
#     hostname             = "boots-server.uow-carbon.org"
#     upload_bucket_name   = "boots_uploads"
#     replicas             = 1
#     cpu_request          = "1"
#     memory_request       = "6Gi"
#     cpu_limit            = "1"
#     memory_limit         = "6Gi"
#     persistent_disk_size = "20Gi"
#     api_uvicorn_workers                      = 2
#     processing_job_cpu_request                = "1850m"
#     processing_job_memory_request             = "12Gi"
#     processing_job_cpu_limit                  = "1850m"
#     processing_job_memory_limit               = "12Gi"
#     processing_job_ephemeral_storage          = "10Gi"
#     processing_job_active_deadline_seconds    = 86400
#     processing_job_ttl_seconds_after_finished = 604800
#     processing_job_max_active                 = 1
#   }
# }

# Set create_test_dns_record = false if you do not want
# boots-k8s-server.uow-carbon.org created for a backend:
#
# gke_backend_overrides = {
#   boots = {
#     create_test_dns_record = false
#   }
# }
