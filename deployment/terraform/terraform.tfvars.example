# OGRRE Infrastructure Configuration Template
# Copy this file to terraform.tfvars and customize the values for your deployment.

# ==============================================================================
# 1. Required Project Identity
# ==============================================================================
project_id         = "your-gcp-project-id"
dns_managed_zone   = "your-dns-zone"
backend_dns_domain = "your-domain.org"

# Optional: default region for resources (defaults to "us-central1")
# region = "us-central1"

# ==============================================================================
# 2. Environments and Collaborator Backends
# ==============================================================================
# Define the backends/collaborators to deploy on GKE. Keys are backend names.
# Default naming conventions:
# - Namespace: uow-<name>
# - Hostname: <name>-server.<backend_dns_domain>
# - Test hostname: <name>-k8s-server.<backend_dns_domain>
# - Upload bucket: <name>_uploads
gke_backends = {
  staging = {
    upload_bucket_name = "staging-uploads"
    replicas           = 1
  }
  # Example collaborator definition:
  # boots = {
  #   upload_bucket_name = "boots_uploads"
  #   replicas           = 1
  # }
}

# ==============================================================================
# 3. Optional Per-Backend Overrides
# ==============================================================================
# Overrides merged over gke_backends for fine-tuning resources or custom domains.
# gke_backend_overrides = {
#   boots = {
#     replicas             = 2
#     cpu_request          = "1"
#     memory_request       = "4Gi"
#     cpu_limit            = "1"
#     memory_limit         = "4Gi"
#     persistent_disk_size = "20Gi"
#     api_uvicorn_workers  = 2
#     create_test_dns_record = false
#   }
# }

# ==============================================================================
# 4. Optional CORS Origins
# ==============================================================================
# Optional complete CORS origin list per upload bucket. Defaults to frontend
# custom domains, plus http://localhost:3000 and http://localhost:3001 for staging.
# upload_bucket_cors_origins = {
#   uploaded_documents_v0 = [
#     "https://uow-carbon.org",
#     "http://localhost:3000",
#     "http://localhost:3001",
#     "http://localhost:3002",
#   ]
# }
